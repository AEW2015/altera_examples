CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_TX_GPIO=17
CONFIG_ESP_CONSOLE_UART_RX_GPIO=16
CONFIG_ESP_CONSOLE_UART_BAUDRATE=2000000
CONFIG_ESP_SDR_UART_TX_PIN=17
CONFIG_ESP_SDR_UART_RX_PIN=16
CONFIG_FREERTOS_UNICORE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_LOG_DEFAULT_LEVEL_NONE=y

# Recover automatically if a blocking vendor PHY setup starves the idle task.
# This is a 5 s watchdog recovery policy, not a PHY fix or 500 ms RF timer.
CONFIG_ESP_TASK_WDT_PANIC=y

CONFIG_ATUM_TX_LAB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
# CONFIG_PM_ENABLE is not set
