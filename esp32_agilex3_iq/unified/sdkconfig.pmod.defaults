# Digilent Pmod ESP32: application UART0 on J1, ROM download stays on J2 GPIO1/3.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=17
CONFIG_ESP_CONSOLE_UART_RX_GPIO=16
CONFIG_ESP_SDR_UART_TX_PIN=17
CONFIG_ESP_SDR_UART_RX_PIN=16
